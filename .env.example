# Local dev configuration. Copy to .env and fill in.
# Domain is never hardcoded; CDK and local dev both read it.
DOMAIN_NAME=example.com

# Deployment env label for local synth (dev|staging|prod)
ENV=dev

# AWS region for regional resources
AWS_REGION=us-east-1

# Local dev API base (widget dev server points here)
VITE_API_BASE=http://localhost:3000

# Model provider key — LOCAL DEV ONLY. In AWS this comes from Secrets Manager.
MODEL_API_KEY=
