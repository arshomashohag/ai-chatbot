{
  "name": "chatbot-platform",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit || pnpm -r --parallel typecheck",
    "test": "vitest run",
    "build": "pnpm -r build",
    "synth": "pnpm --filter @platform/infra synth",
    "widget:size": "node scripts/check-widget-size.mjs",
    "ci:local": "pnpm install --frozen-lockfile && pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @platform/widget build && pnpm widget:size && pnpm synth"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
